class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        String ans = "";
        int l=0,ones=0;
        for (int r=0;r<s.length();r++) {
            if(s.charAt(r)=='1')ones++;
            while(ones>k)
                if(s.charAt(l++)=='1')ones--;
            if(ones==k) {
                while(s.charAt(l)=='0')l++;
                String x=s.substring(l,r+1);
                if (ans.isEmpty()||x.length()< ans.length()||(x.length()==ans.length()&&x.compareTo(ans)<0))
                    ans = x;
            }
        }
        return ans;
    }
}
