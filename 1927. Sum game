class Solution {
    public boolean sumGame(String num) {
        int n=num.length();
        int sum=0,q=0;
        for (int i=0;i<n;i++) {
            if (num.charAt(i)=='?') {
                q+=(i<n/2)?-1:1;
            }else{
                int x=num.charAt(i)-'0';
                sum+=(i<n/2)?x:-x;
            }
        }
        return 2*sum!=9*q;
    }
}
