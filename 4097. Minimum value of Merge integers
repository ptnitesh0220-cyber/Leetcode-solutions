class Solution {
    public int minMergedInteger(int[] nums) {
        int min=Integer.MAX_VALUE;
        for(int i=1;i<nums.length;i++){
            String a=String.valueOf(nums[i-1]);
            String b=String.valueOf(nums[i]);
            String ans=a+b;
            int an=Integer.parseInt(ans);
            if(an<min)min=an;
            i++;
        }
        return min;
    }
}
