#include <limits.h>

int maximumProduct(int* nums, int numsSize) {
    int m1 = INT_MIN, m2 = INT_MIN, m3 = INT_MIN;
    int n1 = INT_MAX, n2 = INT_MAX;

    for (int i = 0; i < numsSize; i++) {
        int num = nums[i];

        // Update three largest numbers
        if (num > m1) {
            m3 = m2;
            m2 = m1;
            m1 = num;
        } else if (num > m2) {
            m3 = m2;
            m2 = num;
        } else if (num > m3) {
            m3 = num;
        }

        // Update two smallest numbers
        if (num < n1) {
            n2 = n1;
            n1 = num;
        } else if (num < n2) {
            n2 = num;
        }
    }

    int product1 = m1 * m2 * m3;
    int product2 = n1 * n2 * m1;

    return (product1 > product2) ? product1 : product2;
}
