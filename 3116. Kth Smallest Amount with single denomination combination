class Solution {
    long gcd(long a, long b) {
        return b==0?a:gcd(b,a%b);
    }
    long count(long x, int[] a) {
        long ans=0;
        for (int m=1;m<(1<<a.length);m++) {
            long l=1;
            int bits=0;
            for (int i=0;i<a.length;i++)
                if((m&(1<<i))>0) {
                    bits++;
                    l=l/gcd(l,a[i])*a[i];
                    if(l>x)break;
                }
            if (l<=x)
                ans+=bits%2==1?x/l:-x/l;
        }
        return ans;
    }
    public long findKthSmallest(int[] a, int k) {
        long l=1,r =(long)a[0]*k;
        while(l<r) {
            long m=(l+r)/2;
            if(count(m,a)>=k)r=m;
            else l=m+1;
        }
        return l;
    }
}
