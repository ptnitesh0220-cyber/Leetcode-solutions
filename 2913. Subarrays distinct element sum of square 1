class Solution {
    public int sumCounts(List<Integer> a) {
        int ans=0,n=a.size();
        for(int i=0;i<n;i++){
            Set<Integer> s=new HashSet<>();
            for(int j=i;j<n;j++){
                s.add(a.get(j));
                ans+=s.size()*s.size();
            }
        }
        return ans;
    }
}
