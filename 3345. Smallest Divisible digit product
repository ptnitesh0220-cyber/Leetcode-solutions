class Solution {
    public int smallestNumber(int n, int t) {
        while(n!=0){
            int a=n;
            int pro=1;
            while(a!=0){
                pro*=a%10;
                a/=10;
            }
            if(pro%t==0)
            return n;
            n++;
        }
        return 0;
    }
}
