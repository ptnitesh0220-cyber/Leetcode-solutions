class Solution {
    public int minInsertions(String s) {
        int a=0,b=0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='(') a++;
            else{
                if(i+1<s.length() && s.charAt(i+1)==')') i++;
                else b++;
                if(a>0) a--;
                else b++;
            }
        }
        return b+2*a;
    }
}
