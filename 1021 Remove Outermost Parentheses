class Solution {
    public String removeOuterParentheses(String s) {
        String ans="";
        int c=0;
        for(char x:s.toCharArray()){
            if(x=='('){
                if(c>0) ans+=x;
                c++;
            }else{
                c--;
                if(c>0) ans+=x;
            }
        }
        return ans;
    }
}
