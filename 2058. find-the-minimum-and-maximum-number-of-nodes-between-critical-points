class Solution {
    public int[] nodesBetweenCriticalPoints(ListNode head) {
        int f=-1;
        int l=-1;
        int ind=1;
        int min=Integer.MAX_VALUE;
        ListNode prv=head;
        ListNode cur=head.next;
        while (cur.next!=null) {
            if ((cur.val>prv.val&&cur.val>cur.next.val)||(cur.val<prv.val&&cur.val<cur.next.val)) {
                if (f==-1) {
                    f=ind;
                    l=ind;
                }else{
                    min=Math.min(min,ind-l);
                    l=ind;
                }
            }
            prv=cur;
            cur=cur.next;
            ind++;
        }
        if (f==l) {
            return new int[]{-1,-1};
        }
        return new int[]{min,l-f};
    }
}
