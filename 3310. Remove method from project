class Solution {
    public List<Integer> remainingMethods(int n, int k, int[][] invocations) {
         List<Integer>[] list = new ArrayList[n];
        for (int i = 0; i < n; i++)
            list[i] = new ArrayList<>();
        for (int[] e : invocations)
            list[e[0]].add(e[1]);
        boolean[] bad = new boolean[n];
        Stack<Integer> st = new Stack<>();
        bad[k] = true;
        st.push(k);
        while (!st.isEmpty()) {
            int x = st.pop();
            for (int y : list[x]) {
                if (!bad[y]) {
                    bad[y] = true;
                    st.push(y);
                }
            }
        }
        for (int[] e : invocations) {
            if (!bad[e[0]] && bad[e[1]]) {
                List<Integer> ans = new ArrayList<>();
                for (int i = 0; i < n; i++)
                    ans.add(i);
                return ans;
            }
        }
        List<Integer> ans = new ArrayList<>();
        for (int i = 0; i < n; i++)
            if (!bad[i])
                ans.add(i);
        return ans;
    }
}
