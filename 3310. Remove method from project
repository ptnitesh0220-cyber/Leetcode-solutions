class Solution {
    public List<Integer> remainingMethods(int n, int k, int[][] invocations) {
        boolean[] bad = new boolean[n];
        bad[k] = true;
        List<Integer>[] g = new ArrayList[n];
        for (int i = 0; i < n; i++)
            g[i] = new ArrayList<>();
        for (int[] e : invocations)
            g[e[0]].add(e[1]);
        Queue<Integer> q = new LinkedList<>();
        q.add(k);
        while (!q.isEmpty()) {
            int x = q.poll();

            for (int y : g[x]) {
                if (!bad[y]) {
                    bad[y] = true;
                    q.add(y);
                }
            }
        }
        for (int[] e : invocations) {
            if (!bad[e[0]] && bad[e[1]]) {
                List<Integer> all = new ArrayList<>();
                for (int i = 0; i < n; i++)
                    all.add(i);
                return all;
            }
        }
        List<Integer> ans = new ArrayList<>();
        for (int i = 0; i < n; i++)
            if (!bad[i])
                ans.add(i);
        return ans;
    }
}
