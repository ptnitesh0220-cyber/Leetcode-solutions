class Solution {
    public int largestInteger(int[] nums, int k) {
        int ans = -1;
        for (int i = 0; i < nums.length; i++) {
            int count = 0;
            for (int j = 0; j < nums.length; j++)
                if (nums[i] == nums[j])
                    count++;
            if (count == 1 && (k == 1 || i == 0 || i == nums.length - 1))
                ans = Math.max(ans, nums[i]);
        }
        return k == nums.length ? getMax(nums) : ans;
    }
    int getMax(int[] nums) {
        int max = nums[0];
        for (int x : nums)
            max = Math.max(max, x);
        return max;
    }
}
