class Solution {
    public int maxNumberOfFamilies(int n, int[][] a) {
        for (int i=0;i<a.length-1;i++) {
            for (int j=i+1;j<a.length;j++) {
                if (a[i][0]>a[j][0]) {
                    int[] temp=a[i];
                    a[i]=a[j];
                    a[j]=temp;
                }
            }
        }
        int ans=2*n,i=0;
        while (i<a.length) {
            int row=a[i][0];
            boolean[] s=new boolean[11];
            while (i<a.length&&a[i][0]==row)s[a[i++][1]]=true;
            boolean l=true,m=true,r=true;
            for (int j=2;j<=5;j++)if(s[j])l=false;
            for (int j=4;j<=7;j++)if(s[j])m=false;
            for (int j=6;j<=9;j++)if(s[j])r=false;
            if (l && r)continue;
            if (l||m||r)ans--;
            else ans-= 2;
        }
        return ans;
    }
}
