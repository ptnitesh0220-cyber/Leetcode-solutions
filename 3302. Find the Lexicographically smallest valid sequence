class Solution {
    public int[] validSequence(String word1, String word2) {
        int N = word1.length();
        int M = word2.length();
        int R = M - 1;
        int C = 0;
        int[] Right = new int[N];
        for (int i = N - 1; i >= 0; i--) {
            Right[i] = C;
            if (R >= 0 && word1.charAt(i) == word2.charAt(R)) {
                R--;
                C++;
            }
        }
        int[] temp = new int[M];
        int count = 0;
        boolean changed = false;
        int j = 0;
        for (int i = 0; i < N && j < M; i++) {
            if (word1.charAt(i) == word2.charAt(j)) {
                temp[count++] = i;
                j++;
            }
            else if (!changed && Right[i] >= M - 1 - j) {
                temp[count++] = i;
                j++;
                changed = true;
            }
        }
        if (j == M) {
            int[] ans = new int[M];
            for (int i = 0; i < M; i++) {
                ans[i] = temp[i];
            }
            return ans;
        }
        return new int[0];
    }
}
