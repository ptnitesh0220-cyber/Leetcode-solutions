class Solution {
    public List<String> removeInvalidParentheses(String s) {
        Set<String> q=new HashSet<>();q.add(s);
        while(true){
            List<String> a=new ArrayList<>();
            for(String x:q){
                int c=0;
                for(char ch:x.toCharArray()){
                    if(ch=='(')c++;
                    if(ch==')'&&--c<0)break;
                }
                if(c==0)a.add(x);
            }
            if(!a.isEmpty())return a;
            Set<String> n=new HashSet<>();
            for(String x:q)
                for(int i=0;i<x.length();i++)
                    if("()".indexOf(x.charAt(i))>=0)
                        n.add(x.substring(0,i)+x.substring(i+1));
            q=n;
        }
    }
}
