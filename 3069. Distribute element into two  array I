class Solution{
    public int[] resultArray(int[] n){
        int[] a=new int[n.length];
        int[] b=new int[n.length];
        int[] r=new int[n.length];
        int x=0,y=0,k=0;
        a[x++]=n[0];
        b[y++]=n[1];
        for(int i=2;i<n.length;i++){
            if(a[x-1]>b[y-1])a[x++]=n[i];
            else b[y++]=n[i];
        }
        for(int i=0;i<x;i++)r[k++]=a[i];
        for(int i=0;i<y;i++)r[k++]=b[i];
        return r;
    }
}
