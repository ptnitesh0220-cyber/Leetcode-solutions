class Solution {
    int m,n;
    void dfs(int[][] g,int i,int j){
        if(i<0||j<0||i>=m||j>=n||g[i][j]==1) return;
        g[i][j]=1;
        dfs(g,i+1,j);
        dfs(g,i-1,j);
        dfs(g,i,j+1);
        dfs(g,i,j-1);
    }
    public int closedIsland(int[][] g) {
        m=g.length;
        n=g[0].length;
        for(int i=0;i<m;i++){
            dfs(g,i,0);
            dfs(g,i,n-1);
        }
        for(int j=0;j<n;j++){
            dfs(g,0,j);
            dfs(g,m-1,j);
        }
        int c=0;
        for(int i=0;i<m;i++)
            for(int j=0;j<n;j++)
                if(g[i][j]==0){
                    c++;
                    dfs(g,i,j);
                }
        return c;
    }
}
