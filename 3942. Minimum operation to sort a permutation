class Solution {
    public int minOperations(int[] nums) {
        int n=nums.length,z=0;
        for(int i=0;i<n;i++)if(nums[i]==0)z=i;
        int ans=Integer.MAX_VALUE;
        for(int s:new int[]{1,-1}) {
            boolean ok=true;
            for(int i=1;i<n;i++) {
                int a=(z+(i-1)*s+n)%n;
                int b=(z+i*s+n)%n;
                if(nums[a]>nums[b])ok=false;
            }
            if(ok) {
                if(s==1)ans=Math.min(ans,Math.min(z,n-z+2));
                else ans=Math.min(ans,Math.min(z+2,n-z));
            }
        }

        return ans==Integer.MAX_VALUE?-1:ans;
    }
}
