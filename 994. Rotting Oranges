class Solution {
    public int orangesRotting(int[][] grid) {
        int r=grid.length,c=grid[0].length;
        Queue<int[]> q=new LinkedList<>();
        for(int i=0;i<r;i++)for(int j=0;j<c;j++)if(grid[i][j]==2)q.add(new int[]{i,j,0});
        int ans=0;
        int[] diff={0,1,0,-1,0};
        while(!q.isEmpty()){
            int[] a=q.poll();
            int row=a[0],col=a[1],min=a[2];
            ans=min;
            for(int i=0;i<4;i++){
            int ar=row+diff[i],ac=col+diff[i+1];
            if(ar>=0 && ar<r && ac>=0 && ac<c ){
                if(grid[ar][ac]==1){
                    grid[ar][ac]=2;
                    q.add(new int[]{ar,ac,min+1});
                }
            }
        }
        }
        for(int i=0;i<r;i++)for(int j=0;j<c;j++)if(grid[i][j]==1)return -1;
        return ans;
        
            
        
    }
}
