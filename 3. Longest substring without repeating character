class Solution {
    public int lengthOfLongestSubstring(String s) {
        int l=0,ans=0;
        int a[]=new int[128];
        for(int r=0;r<s.length();r++){
            char c=s.charAt(r);
            l=Math.max(l,a[c]);
            ans=Math.max(ans,r-l+1);
            a[c]=r+1;
        }
        return ans;
    }
}
