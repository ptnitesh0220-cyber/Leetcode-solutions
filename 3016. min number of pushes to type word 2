class Solution {
    public int minimumPushes(String word) {
        int[] a=new int[26];
        for(int i=0;i<word.length();i++){
            char ch=word.charAt(i);
            a[ch-'a']++;
        }
        Arrays.sort(a);
        int ans=0,c=0;
        for(int i=25;i>=0;i--){
            if(a[i]==0)break;
            int b=(c/8)+1;
            ans+=a[i]*b;
            c++;
        }
        return ans;
    }
}
