class Solution {
    public int countDaysTogether(String a, String b, String c, String d) {
        int x = Math.max(day(a), day(c));
        int y = Math.min(day(b), day(d));
        return Math.max(0, y - x + 1);
    }
    int day(String s) {
        int m = Integer.parseInt(s.substring(0,2));
        int d = Integer.parseInt(s.substring(3));
        int a[] = {31,28,31,30,31,30,31,31,30,31,30,31};
        for(int i=0;i<m-1;i++) d+=a[i];
        return d;
    }
}
