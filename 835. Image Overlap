class Solution {
    public int largestOverlap(int[][] a, int[][] b) {
        int n=a.length, ans=0;
        for(int x=-n+1;x<n;x++)
            for(int y=-n+1;y<n;y++){
                int c=0;
                for(int i=0;i<n;i++)
                    for(int j=0;j<n;j++)
                        if(i+x>=0&&i+x<n&&j+y>=0&&j+y<n&&a[i][j]==1&&b[i+x][j+y]==1) c++;
                ans=Math.max(ans,c);
            }
        return ans;
    }
}
