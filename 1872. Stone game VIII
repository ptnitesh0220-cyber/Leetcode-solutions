class Solution {
    public int stoneGameVIII(int[] stones) {
        int n=stones.length;
        int[] a=new int[n];
        a[0]=stones[0];
        for(int i=1;i<n;i++) {
            a[i]=a[i-1]+stones[i];
        }
        int ans=a[n-1];
        for (int i=n-2;i>=1;i--) {
            ans=Math.max(ans,a[i]-ans);
        }
        return ans;
    }
}
