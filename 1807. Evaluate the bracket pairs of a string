class Solution {
    public String evaluate(String s, List<List<String>> k) {
        HashMap<String,String> m=new HashMap<>();
        for(List<String> a:k) m.put(a.get(0),a.get(1));
        String ans="";
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='('){
                int j=s.indexOf(')',i);
                String x=s.substring(i+1,j);
                ans+=m.getOrDefault(x,"?");
                i=j;
            }
            else ans+=s.charAt(i);
        }
        return ans;
    }
}
