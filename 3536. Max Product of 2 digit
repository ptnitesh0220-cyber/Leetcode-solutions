class Solution {
    public int maxProduct(int n) {
       if(n<=0)
       return 0;
       int m1=0,m2=0;
       while(n>0){
        int a=n%10;
        if(a>m1){
            m2=m1;
            m1=a;
        }
        else if(m2<a)
        m2=a;
        n/=10;
       } 
       return m1*m2;
    }
}
