class Solution {
    public String smallestPalindrome(String s) {
        int[] count=new int[26];
        int n=s.length();
        for(int i=0;i<n;i++){
            char ch=s.charAt(i);
            count[ch-'a']++;
        }
        StringBuilder left=new StringBuilder();
        String mid="";
        for(int i=0;i<26;i++){
            while(count[i]>=2){
                left.append((char)(i+'a'));
                count[i]-=2;
            }
            if(count[i]==1){
                mid+=(char)(i+'a');
                count[i]-=1;
            }
        }
        String right=left.reverse().toString();
        String a=left.reverse().toString();
        return a+mid+right;
    }
}
